 }
+
+/**
+ * covibe integration: when OMP_COLLAB_RELAY is set, start hosting headlessly on
+ * boot using a caller-provided room id + key (OMP_COLLAB_ROOM / OMP_COLLAB_KEY,
+ * base64url of key‖writeToken) so the orchestrator owns a stable, enumerable
+ * link with no minting or scraping. Returns the live host, or undefined when no
+ * relay is configured.
+ */
+export async function maybeAutostartCollab(ctx: InteractiveModeContext): Promise<CollabHost | undefined> {
+	const relay = process.env.OMP_COLLAB_RELAY;
+	if (!relay) return undefined;
+	const webUrl = process.env.OMP_COLLAB_WEB ?? "";
+	const roomId = process.env.OMP_COLLAB_ROOM;
+	const keyB64 = process.env.OMP_COLLAB_KEY;
+	let preset: { roomId: string; key: Uint8Array; writeToken: Uint8Array } | undefined;
+	if (roomId && keyB64) {
+		const secret = new Uint8Array(Buffer.from(keyB64, "base64url"));
+		if (secret.byteLength === ROOM_KEY_BYTES + WRITE_TOKEN_BYTES) {
+			preset = {
+				roomId,
+				key: secret.subarray(0, ROOM_KEY_BYTES),
+				writeToken: secret.subarray(ROOM_KEY_BYTES),
+			};
+		}
+	}
+	const host = new CollabHost(ctx);
+	await host.start(relay, webUrl, preset);
+	return host;
+}
