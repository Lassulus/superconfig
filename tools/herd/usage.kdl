bin "herd"
about "Start an omp agent in a new herdr tab (current workspace, current directory) and print its pane id"

flag "-f --focus" help="Switch to the new pane instead of staying in the current one (must come before the prompt)"

arg "[prompt]" help="First message for omp"
arg "[omp-args...]" help="Arguments passed through to omp, e.g. --model opus"
