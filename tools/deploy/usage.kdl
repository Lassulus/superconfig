bin "deploy"
about "Build a machine on its target host in a systemd unit, review source and closure diffs, then switch"

flag "--flake" help="Path to the flake (default: .)" {
  arg "<path>"
}
arg "<machine>" help="Machine configuration to deploy"
arg "[target_host]" help="SSH destination to deploy to, [user@]host (default: <machine>.r, user defaults to root)"
