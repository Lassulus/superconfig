bin "covibe"
about "Run omp as a session on the omni.lassul.us omnigent dashboard (agent stays local, transcript + diff view + sharing live on the server)"

flag "-p --prompt" help="Run one non-interactive turn with this prompt and exit"
flag "--fork" help="Continue an existing session id from its fork point on this machine"
arg "[omnigent-run-args...]" help="Arguments passed through to `omnigent run`"
