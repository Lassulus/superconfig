bin "covibe"
about "Run omp's TUI as a shared session on the omni.lassul.us omnigent dashboard (transcript, diff view and read-only/read-write sharing live on the server)"

flag "-c --continue" help="Continue the previous omp session in this directory"
flag "-r --resume" help="Resume an omnigent session (no value opens the picker)"
arg "[omp-args...]" help="Arguments passed through to omp"
