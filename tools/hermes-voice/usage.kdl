bin "hermes-voice"
about "Serve a page for live voice conversations with Hermes through OpenAI gpt-live-1"

flag "--listen" help="host:port to serve on; IPv6 as [::]:port (default: 127.0.0.1:8790)" {
  arg "<host:port>"
}
flag "--hermes-url" help="Hermes API server base URL, e.g. https://hermes.lassul.us" required=#true {
  arg "<url>"
}
flag "--hermes-key-file" help="File holding the Hermes API_SERVER_KEY (clan vars get coaxmetal hermes-api/api_key)" required=#true {
  arg "<file>"
}
flag "--openai-key-file" help="File holding the OpenAI API key" required=#true {
  arg "<file>"
}
flag "--access-token-file" help="File holding the token every API route requires; mandatory unless listening on loopback, since the page drives Hermes" {
  arg "<file>"
}
flag "--config" help="JSON file with voice, model, idle_seconds, glossary and instructions" {
  arg "<file>"
}
flag "--static" help="Page directory (default: $HERMES_VOICE_STATIC, set by the package)" {
  arg "<dir>"
}
